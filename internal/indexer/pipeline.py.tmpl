"""CocoIndex pipeline — generated by claude-kit.
Indexes sources into SQLite chunks for claude-kit's knowledge graph.
Do not add embeddings here — claude-kit handles that with Model2Vec.
"""
from __future__ import annotations

import os
from dataclasses import dataclass
from pathlib import Path

import cocoindex as coco
from cocoindex.connectors import localfs, sqlite
from cocoindex.resources.file import PatternFilePathMatcher

# -- Config (override via env vars) --
SOURCE_DIR = Path(os.getenv("CK_INDEX_SOURCE", "."))
SQLITE_PATH = os.getenv("CK_INDEX_DB", os.path.expanduser("~/.claude-kit/index.sqlite"))
PATTERNS = os.getenv("CK_INDEX_PATTERNS", "**/*.go,**/*.py,**/*.ts,**/*.js,**/*.md,**/*.yaml,**/*.json").split(",")

# -- Context --
SQLITE_DB = coco.StorageContext("target_db", sqlite.Spec(path=SQLITE_PATH, load_vec=False))


@dataclass
class Chunk:
    """A text chunk from a source file — no embedding, claude-kit handles that."""
    filename: str
    source_type: str
    chunk_text: str
    chunk_start: int
    chunk_end: int


@coco.flow_def(name="ck_index")
def ck_index_flow(flow_builder: coco.FlowBuilder, source_dir: str) -> None:
    """Index local files into SQLite chunks."""
    data_scope = flow_builder.add_scope(
        localfs.LocalFile(path=source_dir, included_patterns=PATTERNS, binary=False)
    )
    data_scope["filename"] = data_scope.auto()
    content = data_scope["content"]

    # Split into chunks
    chunks = content.transform(
        coco.functions.SplitRecursively(),
        language="text",
        chunk_size=1500,
        chunk_overlap=200,
    )

    # Collect into table
    chunks.export(
        "chunks",
        sqlite.Table(
            SQLITE_DB,
            table_name="chunks",
        ),
        primary_key_fields=["filename", "chunk_start"],
        fields={
            "filename": data_scope["filename"],
            "source_type": "local",
            "chunk_text": chunks["text"],
            "chunk_start": chunks["start"],
            "chunk_end": chunks["end"],
        },
    )
